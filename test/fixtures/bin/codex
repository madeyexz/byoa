#!/bin/bash
# A stand-in for the codex CLI in byoa's own tests only: it prints what codex-cli 0.171.0 prints for the commands
# byoa runs. It is never installed in a sandbox; the real checks (V3, V11) use the real binary.
case "$1" in
  --version) echo "codex-cli 0.171.0" ;;
  login)
    if [ "$2" = "--device-auth" ]; then
      echo "Welcome to Codex [v0.171.0]"
      echo
      echo "Follow these steps to sign in with ChatGPT using device code authorization:"
      echo
      echo "1. Open this link in your browser and sign in to your account"
      echo "   https://auth.openai.com/codex/device"
      echo
      echo "2. Enter this one-time code (expires in 15 minutes)"
      echo "   ABCD-12345"
      echo
      sleep 1 # the user enters the code on OpenAI's page
      mkdir -p "$CODEX_HOME"
      t=lab-secret-codex
      # FAKE_CODEX_EXP: the access token is a JWT that ends then (seconds since 1970), as the real one does
      [ -n "$FAKE_CODEX_EXP" ] && t="h.$(printf '{"exp":%s}' "$FAKE_CODEX_EXP" | base64 | tr -d '=\n' | tr '+/' '-_').lab-secret-codex"
      echo "{\"tokens\":{\"access_token\":\"$t\"}}" > "$CODEX_HOME/auth.json"
      echo "Successfully logged in"
    fi ;;
  logout) rm -f "$CODEX_HOME/auth.json" ;;
  app-server)
    # JSON-RPC on stdin, as codex-cli 0.171.0's app server: model/list answers in two pages
    while read -r line; do
      case "$line" in
        *'"model/list"'*'"cursor"'*) echo '{"id":"byoa-models","result":{"data":[{"model":"gpt-secret","displayName":"Hidden","description":"","hidden":true,"isDefault":false,"supportedReasoningEfforts":[]}],"nextCursor":null}}' ;;
        *'"model/list"'*) echo '{"id":"byoa-models","result":{"data":[{"model":"gpt-6.2-sol","displayName":"GPT-6.2-Sol","description":"Fast","hidden":false,"isDefault":true,"supportedReasoningEfforts":[{"reasoningEffort":"low","description":""},{"reasoningEffort":"ultra","description":""}]}],"nextCursor":"p2"}}' ;;
      esac
    done ;;
  exec)
    task=$(cat)
    # R5.9: like codex-cli 0.171.0, it keeps a session (a rollout file of its messages) unless --ephemeral, names its
    # thread in thread.started, and `exec resume <id> -` continues it
    thread=th1
    if [ "$2" = resume ]; then thread=${@: -2:1}; fi
    rollout=$CODEX_HOME/sessions/2026/11/25/rollout-2026-11-25T00-00-00-$thread.jsonl
    if [[ "$*" != *--ephemeral* ]]; then
      if [ "$2" = resume ] && [ ! -s "$rollout" ]; then echo "Error: no rollout found for thread id $thread" >&2; exit 1; fi
      echo "{\"type\":\"thread.started\",\"thread_id\":\"$thread\"}"
      n=$(cat "$rollout" 2>/dev/null | wc -l | tr -d ' ')
      echo "{\"type\":\"item.completed\",\"item\":{\"id\":\"r\",\"type\":\"agent_message\",\"text\":\"remembers $n\"}}"
      mkdir -p "$(dirname "$rollout")" && printf '%s\n' "$task" | head -1 >> "$rollout"
    fi
    if [[ "$task" == *cred* ]]; then
      t=$(sed -E 's/.*"access_token":"([^"]*)".*/\1/' "$CODEX_HOME/auth.json" 2>/dev/null)
      [ -n "$t" ] && echo "{\"tokens\":{\"access_token\":\"${t}x\"}}" > "$CODEX_HOME/auth.json"
      echo "{\"type\":\"item.completed\",\"item\":{\"id\":\"m\",\"type\":\"agent_message\",\"text\":\"cred: ${t:-none}\"}}"
      echo '{"type":"turn.completed","usage":{}}'
      exit 0
    fi
    if [[ "$task" == *together* ]]; then
      # how many jobs run now: each one leaves a file in FAKE_CODEX_DIR while it runs
      mkdir -p "$FAKE_CODEX_DIR"; touch "$FAKE_CODEX_DIR/$$"; sleep 1
      n=$(ls "$FAKE_CODEX_DIR" | wc -l | tr -d ' '); rm -f "$FAKE_CODEX_DIR/$$"
      echo "{\"type\":\"item.completed\",\"item\":{\"id\":\"m\",\"type\":\"agent_message\",\"text\":\"together: $n\"}}"
      echo '{"type":"turn.completed","usage":{}}'
      exit 0
    fi
    args=$(printf '%s' "$*" | sed 's/["\\]/\\&/g')
    echo '{"type":"thread.started","thread_id":"th1"}'
    echo '{"type":"turn.started"}'
    echo '{"type":"item.started","item":{"id":"item_1","type":"mcp_tool_call","server":"notes","tool":"whoami","arguments":{},"status":"in_progress"}}'
    echo '{"type":"item.completed","item":{"id":"item_1","type":"mcp_tool_call","server":"notes","tool":"whoami","arguments":{},"result":{"content":[{"type":"text","text":"you are alice"}]},"status":"completed"}}'
    echo "{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"agent_message\",\"text\":\"args: $args; home: ${CODEX_HOME##*/}\"}}"
    echo '{"type":"turn.completed","usage":{"input_tokens":10,"cached_input_tokens":5,"output_tokens":3}}'
    ;;
esac
