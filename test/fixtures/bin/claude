#!/bin/bash
# A stand-in for the claude CLI in byoa's own tests only: it prints what Claude Code 2.1.330 prints for the commands
# byoa runs. It is never installed in a sandbox; the real checks (V3, V11) use the real binary.
case "$1" in
  --version) echo "2.1.330 (Claude Code)" ;;
  auth)
    case "$2" in
      login)
        echo "Browser didn't open? Use the url below to sign in (c to copy)"
        echo
        echo "https://claude.ai/oauth/authorize?code=true&client_id=test-client&response_type=code&state=xyz"
        echo
        printf "Paste code here if prompted > "
        read -r code
        if [ "$code" = "good-code" ]; then
          mkdir -p "$CLAUDE_CONFIG_DIR"
          # FAKE_CLAUDE_EXP: the access token ends then (ms since 1970), as expiresAt in the real file says
          echo "{\"claudeAiOauth\":{\"accessToken\":\"lab-secret-claude\"${FAKE_CLAUDE_EXP:+,\"expiresAt\":$FAKE_CLAUDE_EXP}}}" > "$CLAUDE_CONFIG_DIR/.credentials.json"
          echo "Login successful."
        else
          echo "Couldn't log in: invalid code"
          exit 1
        fi ;;
      logout) rm -f "$CLAUDE_CONFIG_DIR/.credentials.json" ;;
    esac ;;
  -p)
    if [[ "$*" == *"--input-format stream-json"* && "$*" != *--replay-user-messages* ]]; then
      # the initialize control request, as Claude Code 2.1.330 answers it: the models this login may use
      read -r line
      echo '{"type":"control_response","response":{"subtype":"success","request_id":"byoa-models","response":{"models":[{"value":"default","displayName":"Default (recommended)","description":"Sonnet 5.5","supportsEffort":true,"supportedEffortLevels":["low","medium","high"]},{"value":"opus","resolvedModel":"claude-opus-5-5","displayName":"Opus","description":"Opus 5.5","supportsEffort":true,"supportedEffortLevels":["low","high","max"]},{"value":"haiku","displayName":"Haiku","description":"Haiku 5.5","supportsEffort":false}]}}}'
      cat >/dev/null
      exit 0
    fi
    # the job's input: stream-json lines (R5.10), each echoed when taken (--replay-user-messages), each one turn.
    # With --session-id or --resume (R5.9), like Claude Code 2.1.330 it keeps a transcript of the session's messages
    # in CLAUDE_CONFIG_DIR/projects/<cwd>/<id>.jsonl, and refuses to resume a session it has no transcript of.
    args=("$@")
    sid=; resume=
    for ((i = 0; i < ${#args[@]}; i++)); do
      [ "${args[i]}" = --session-id ] && sid=${args[i+1]}
      [ "${args[i]}" = --resume ] && { sid=${args[i+1]}; resume=1; }
    done
    transcript=$CLAUDE_CONFIG_DIR/projects/-work/$sid.jsonl
    echo "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"${sid:-s1}\",\"tools\":[]}"
    if [ -n "$resume" ] && [ ! -s "$transcript" ]; then
      echo "No conversation found with session ID: $sid" >&2
      exit 1
    fi
    turn() {
    if [ -n "$ANTHROPIC_BASE_URL" ]; then
      # with a plan (R1.8): one request to ANTHROPIC_BASE_URL with ANTHROPIC_AUTH_TOKEN, with the headers Claude Code
      # 2.1.330 sends, and the answer as the result
      node - "${args[@]}" <<'JS'
const model = process.argv[process.argv.indexOf('--model') + 1]
fetch(process.env.ANTHROPIC_BASE_URL + '/v1/messages?beta=true', {
  method: 'POST',
  headers: { authorization: 'Bearer ' + process.env.ANTHROPIC_AUTH_TOKEN, 'user-agent': 'claude-cli/2.1.330 (external, sdk-cli)', 'x-claude-code-session-id': 'claude-session-1', 'content-type': 'application/json' },
  body: JSON.stringify({ model, max_tokens: 100, messages: [{ role: 'user', content: 'hi' }] }),
}).then(async (r) => {
  const text = await r.text()
  console.log(JSON.stringify({ type: 'result', subtype: 'success', is_error: !r.ok, result: r.ok ? JSON.parse(text).content[0].text : `API Error: ${r.status} ${text}`, usage: {} }))
  process.exit(r.ok ? 0 : 1)
})
JS
      return
    fi
    if [[ "$task" == *cred* ]]; then
      # like a token refresh: report the login it found, then replace it. As Claude Code 2.1.330 does, it writes its
      # files after it printed its result, and keeps a backup of .claude.json (the account, no token)
      t=$(sed -E 's/.*"accessToken":"([^"]*)".*/\1/' "$CLAUDE_CONFIG_DIR/.credentials.json" 2>/dev/null)
      echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"cred: ${t:-none}\",\"usage\":{}}"
      sleep 0.3
      [ -n "$t" ] && echo "{\"claudeAiOauth\":{\"accessToken\":\"${t}x\"}}" > "$CLAUDE_CONFIG_DIR/.credentials.json"
      mkdir -p "$CLAUDE_CONFIG_DIR/backups" && echo '{"oauthAccount":{"emailAddress":"lab-account@example.com"}}' > "$CLAUDE_CONFIG_DIR/backups/.claude.json.backup.$$"
      return
    fi
    if [[ "$task" == *together* ]]; then
      # how many jobs run now: each one leaves a file in FAKE_CLAUDE_DIR while it runs
      mkdir -p "$FAKE_CLAUDE_DIR"; touch "$FAKE_CLAUDE_DIR/$$"; sleep 1
      n=$(ls "$FAKE_CLAUDE_DIR" | wc -l | tr -d ' '); rm -f "$FAKE_CLAUDE_DIR/$$"
      echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"together: $n\",\"usage\":{}}"
      return
    fi
    if [[ "$task" == *crash* ]]; then
      # a CLI that ends with no result event, while its input is still open
      echo "boom" >&2
      exit 3
    fi
    if [[ "$task" == *limit* ]]; then
      # a used-up plan, as Claude Code 2.1.330's stream-json says it: a rate_limit_event that refuses, the API error's
      # assistant message with its kind (error, api_error, api_error_params.rate_limit_info), and the result
      echo '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","resetsAt":4102444800,"rateLimitType":"five_hour","isUsingOverage":false},"uuid":"r1","session_id":"s1"}'
      echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"You've hit your session limit · resets 12am (UTC)\"}]},\"parent_tool_use_id\":null,\"error\":\"rate_limit\",\"is_api_error_message\":true,\"api_error_status\":429,\"api_error\":\"usage_limit_reached\",\"api_error_params\":{\"rate_limit_info\":{\"status\":\"rejected\",\"resetsAt\":4102444800,\"rateLimitType\":\"five_hour\",\"isUsingOverage\":false}},\"uuid\":\"a1\",\"session_id\":\"s1\"}"
      echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":true,\"result\":\"You've hit your session limit · resets 12am (UTC)\",\"usage\":{}}"
      return
    fi
    if [[ "$task" == *busy* ]]; then
      # Anthropic's API is overloaded (529), after Claude Code's own retries
      echo '{"type":"assistant","message":{"content":[{"type":"text","text":"API Error: Repeated 529 errors"}]},"error":"overloaded","is_api_error_message":true,"api_error_status":529,"uuid":"a1","session_id":"s1"}'
      echo '{"type":"result","subtype":"success","is_error":true,"result":"API Error: Repeated 529 errors","usage":{}}'
      return
    fi
    if [[ "$task" == *expire* ]]; then
      echo '{"type":"result","subtype":"success","is_error":true,"result":"OAuth token has expired. Please run /login","usage":{}}'
      return
    fi
    echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"args: ${args[*]}; config: ${CLAUDE_CONFIG_DIR##*/}; autoupdater: $DISABLE_AUTOUPDATER; mcp timeout: $MCP_TIMEOUT\"},{\"type\":\"tool_use\",\"id\":\"t1\",\"name\":\"mcp__notes__whoami\",\"input\":{}}]}}"
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":[{"type":"text","text":"you are alice"}]}]}}'
    echo '{"type":"assistant","message":{"content":[{"type":"text","text":"You are alice."}]}}'
    echo '{"type":"result","subtype":"success","is_error":false,"result":"You are alice.","usage":{"input_tokens":10,"cache_read_input_tokens":5,"output_tokens":3},"total_cost_usd":0.01}'
    }
    while IFS= read -r line; do
      task=$(printf '%s' "$line" | node -e 'let s="";process.stdin.on("data",(c)=>{s+=c}).on("end",()=>process.stdout.write(JSON.parse(s).message.content.map((c)=>c.text).join("")))')
      printf '%s\n' "$line" | sed 's/^{"type":"user",/{"type":"user","isReplay":true,/'
      if [ -n "$sid" ]; then
        mkdir -p "$(dirname "$transcript")"
        n=$(cat "$transcript" 2>/dev/null | wc -l | tr -d ' ')
        echo "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"remembers $n: $(tr '\n' '|' < "$transcript" 2>/dev/null)\"}]}}"
        printf '%s\n' "$task" | head -1 >> "$transcript"
      fi
      if [[ "$task" == *slow* ]]; then sleep 2; fi
      turn
    done
    ;;
esac
