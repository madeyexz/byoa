{
  "name": "@madeyexz/byoa",
  "version": "1.0.0",
  "description": "Run your users' own Claude Code or Codex in any sandbox, with their MCP connections and skills. A library for your own backend.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madeyexz/byoa.git"
  },
  "homepage": "https://byoa.rippling.computer",
  "bugs": {
    "url": "https://github.com/madeyexz/byoa/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "agents",
    "sandbox",
    "e2b",
    "instabox",
    "oauth"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": [
        "./dist/index.d.ts",
        "./src/index.ts"
      ],
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sandbox/e2b": {
      "types": [
        "./dist/sandbox/e2b.d.ts",
        "./src/sandbox/e2b.ts"
      ],
      "bun": "./src/sandbox/e2b.ts",
      "default": "./dist/sandbox/e2b.js"
    },
    "./sandbox/daytona": {
      "types": [
        "./dist/sandbox/daytona.d.ts",
        "./src/sandbox/daytona.ts"
      ],
      "bun": "./src/sandbox/daytona.ts",
      "default": "./dist/sandbox/daytona.js"
    },
    "./sandbox/instabox": {
      "types": [
        "./dist/sandbox/instabox.d.ts",
        "./src/sandbox/instabox.ts"
      ],
      "bun": "./src/sandbox/instabox.ts",
      "default": "./dist/sandbox/instabox.js"
    },
    "./sandbox/local": {
      "types": [
        "./dist/sandbox/local.d.ts",
        "./src/sandbox/local.ts"
      ],
      "bun": "./src/sandbox/local.ts",
      "default": "./dist/sandbox/local.js"
    },
    "./store/postgres": {
      "types": [
        "./dist/store/postgres.d.ts",
        "./src/store/postgres.ts"
      ],
      "bun": "./src/store/postgres.ts",
      "default": "./dist/store/postgres.js"
    },
    "./store/convex": {
      "types": [
        "./dist/store/convex.d.ts",
        "./src/store/convex.ts"
      ],
      "bun": "./src/store/convex.ts",
      "default": "./dist/store/convex.js"
    },
    "./verify": {
      "types": [
        "./dist/verify.d.ts",
        "./src/verify.ts"
      ],
      "bun": "./src/verify.ts",
      "default": "./dist/verify.js"
    },
    "./node": {
      "types": [
        "./dist/node.d.ts",
        "./src/node.ts"
      ],
      "bun": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "test:v11": "BYOA_V11=1 node --test test/v11.test.ts",
    "test:e2b": "BYOA_E2B=1 node --test test/e2b.test.ts",
    "test:daytona": "BYOA_DAYTONA=1 node --test test/daytona.test.ts",
    "test:v4": "BYOA_V4=1 node --test test/v4.test.ts",
    "test:instabox": "BYOA_INSTABOX=1 node --test test/instabox.test.ts",
    "test:v20": "BYOA_V20=1 node --test test/v20.test.ts",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "peerDependencies": {
    "@daytona/sdk": "^2.1.0",
    "convex": "^1.25.0",
    "e2b": "^2.64.0"
  },
  "peerDependenciesMeta": {
    "@daytona/sdk": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "convex": {
      "optional": true
    }
  },
  "devDependencies": {
    "@daytona/sdk": "^2.1.0",
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.0.0",
    "convex": "^1.51.0",
    "convex-test": "^0.0.73",
    "e2b": "^2.64.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
